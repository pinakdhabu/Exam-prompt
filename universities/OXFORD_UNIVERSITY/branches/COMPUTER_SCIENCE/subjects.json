  "branch": {
    "id": "computer-science",
    "name": "Computer Science",
    "description": "University of Oxford Computer Science undergraduate subjects — real curriculum from cs.ox.ac.uk. Three terms per year: Michaelmas (Oct-Dec), Hilary (Jan-Mar), Trinity (Apr-Jun). Examinations at end of academic year."
