          "subjects": [
            {"code": "CS1", "name": "Functional Programming", "abbr": "FP", "type": "core"},
            {"code": "M1", "name": "Discrete Mathematics", "abbr": "DM", "type": "core"},
            {"code": "CS3", "name": "Digital Systems", "abbr": "DS", "type": "core"}
