# Exam Prompt — User Journey Flow
# Student's path from setup to output

direction: right

layers: [
  setup: "Setup"
  actions: "Actions"
  outputs: "Output"
]

setup: "🛠️ Onboarding" {
  university: "🏛️ Pick University"
  subject: "📚 Pick Subject"
  pattern: "📋 Pick Exam Pattern"
  upload: "📤 Upload Syllabus + PYQs"
}

actions: "🎯 Choose Action" {
  write_answer: "✍️ Write Answer" {
    question: Paste question
    marks: Set marks
  }
  generate_notes: "📓 Generate Notes" {
    format: Pick format
    units: Pick units
  }
  analyze_pyqs: "📊 Analyze PYQs" {
    upload_pyqs: Upload past papers
  }
  get_imp: "🎯 Get IMP Topics" {
    auto_analyze: Auto from PYQs
  }
  practice_mcq: "✅ Practice MCQs" {
    topic: Pick topic
    difficulty: Set difficulty
  }
  plan_study: "📅 Study Plan" {
    deadline: Set exam date
    hours: Set hours/day
  }
  flashcards: "🃏 Flashcards" {
    source: Pick material
  }
}

outputs: "📤 Get Results" {
  answer: "📝 10/10 Answer"
  notes: "📖 Complete Notes"
  analysis: "📈 Predictions + Trends"
  imp: "⭐ Prioritized Topics"
  mcqs: "✅ MCQs + Explanations"
  schedule: "🗓️ Day-by-Day Plan"
  cards: "🗂️ Anki Decks"
}

# Flows
setup -> actions: Configured profile
actions -> outputs: Generate
