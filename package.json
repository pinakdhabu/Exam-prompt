{
  "name": "exam-prompt",
  "version": "0.0.0",
  "private": true,
  "description": "Universal Exam Prompt — AI-Powered Exam Preparation System for Any University Worldwide",
  "keywords": [
    "exam-preparation",
    "education",
    "ai-agents",
    "skills",
    "sppu",
    "university",
    "study-tool",
    "rolling-release"
  ],
  "homepage": "https://pinakdhabu.github.io/Exam-prompt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinakdhabu/Exam-prompt.git"
  },
  "license": "MIT",
  "author": "Pinak Dhabu",
  "bin": {
    "exam-prompt": "./bin/exam-prompt.js"
  },
  "type": "commonjs",
  "scripts": {
    "init": "bash scripts/init-project.sh",
    "init:quick": "bash scripts/init-project.sh --quick",
    "detect:university": "node scripts/detect-university.js",
    "detect:university:list": "node scripts/detect-university.js --list",
    "detect:university:active": "node scripts/detect-university.js --active",
    "detect:agent": "node scripts/detect-agent.js",
    "detect:agent:json": "node scripts/detect-agent.js --json",
    "detect:agent:all": "node scripts/detect-agent.js --all",
    "quickstart": "node scripts/quickstart.js",
    "setup": "node scripts/runner.js setup",
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "profile": "node scripts/runner.js profile",
    "profile:show": "node scripts/runner.js profile show",
    "profile:env": "node scripts/runner.js profile env",
    "submit:pyq": "node scripts/runner.js submit-pyq",
    "update": "node scripts/runner.js self-update",
    "update:check": "node scripts/runner.js self-update --check-only",
    "update:fix": "node scripts/runner.js self-update --fix",
    "fetch:qp": "node scripts/fetch-qp.js",
    "convert:pdf": "node scripts/convert-to-pdf.js",
    "convert:pdf:all": "node scripts/batch-convert-to-pdf.js",
    "install:skills": "node scripts/runner.js install",
    "validate:skills": "node scripts/runner.js validate-skills",
    "validate:skills:win": "powershell -ExecutionPolicy Bypass -File scripts/validate-skills.ps1",
    "check:win": "npm run lint && npm run validate:skills:win",
    "generate:agents": "node scripts/runner.js generate-agents-md",
    "generate:config": "node scripts/runner.js generate-agent-config",
    "sync:configs": "node scripts/runner.js generate-agent-config --check",
    "create:skill": "node scripts/runner.js create-skill",
    "lint": "eslint scripts/*.js",
    "lint:fix": "eslint scripts/*.js --fix",
    "check": "npm run lint && npm run validate:skills",
    "format": "npx prettier --write --print-width 100 --prose-wrap always --tab-width 2 '**/*.md' '!node_modules/**' '!.git/**' '!AGENTS.md'",
    "diagrams": "curl -fsSL https://d2lang.com/install.sh | sh -s -- && for f in architectures/d2/*.d2; do d2 \"$f\" \"architectures/exports/$(basename $f .d2).svg\" --theme 300; done",
    "diagram:render": "node scripts/diagram-gen.js",
    "diagram:watch": "node scripts/diagram-gen.js --watch",
    "diagram:formats": "node scripts/diagram-gen.js --list-formats",
    "codespaces": "echo 'Ready! Run: bash scripts/validate-skills.sh'",
    "test:fetch": "node scripts/fetch-qp.js --semester 5 --list",
    "check:schemas": "npm run validate:skills -- --json && node -e \"try{require('ajv')}catch(e){console.log('Install ajv: npm install ajv');process.exit(1)}\"",
    "sync:registry": "node scripts/runner.js update-registry",
    "sync:registry:check": "node scripts/runner.js update-registry --dry-run",
    "scaffold:university": "node scripts/runner.js generate-university-scaffold",
    "build": "npm run validate:skills && npm test && node scripts/batch-convert-to-pdf.js --parallel 4",
    "build:full": "npm run build && npm run fonts:status",
    "test": "node scripts/integrity-check.js",
    "test:win": "node scripts/integrity-check.js",
    "integrity": "node scripts/integrity-check.js",
    "fonts:install": "node scripts/runner.js download-fonts",
    "fonts:test": "node scripts/test-fonts.js",
    "fonts:status": "node -e \"const f=require('fs'),p=require('path');const base=p.join(__dirname,'fonts');const dirs=f.readdirSync(base).filter(d=>f.statSync(p.join(base,d)).isDirectory());dirs.forEach(d=>{const files=f.readdirSync(p.join(base,d));console.log(d+': '+files.length+' files ('+(files.reduce((s,ff)=>s+f.statSync(p.join(base,d,ff)).size,0)/1024).toFixed(0)+'KB)')});\"",
    "cache:stats": "node -e \"const {cacheManager} = require('./infrastructure/cache-manager'); console.log(JSON.stringify(cacheManager.stats(), null, 2));\"",
    "cache:clear": "node -e \"const {cacheManager} = require('./infrastructure/cache-manager'); cacheManager.clear(); console.log('Cache cleared.');\"",
    "session:view": "node -e \"const {sessionContext} = require('./infrastructure/session-context'); console.log(sessionContext.toString());\"",
    "session:reset": "node -e \"const {sessionContext} = require('./infrastructure/session-context'); sessionContext.reset(); console.log('Session reset to defaults.');\"",
    "router:test": "node infrastructure/skill-router.js",
    "validate:output": "node -e \"const {OutputValidator} = require('./infrastructure/output-validator'); const v = new OutputValidator(); console.log('Available schemas:', v.getSchemas());\"",
    "infra:status": "echo '=== Exam Prompt Infrastructure Status ===' && npm run cache:stats && npm run session:view",
    "answer-sheet": "node app.js",
    "answer-sheet:dev": "node app.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^11.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "prettier": "^3.9.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
